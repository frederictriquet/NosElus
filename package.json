{
	"name": "noselus",
	"description": "Projet basé sur SvelteBase template",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"author": "",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:all": "npm run test && npm run test:e2e",
		"test:mutation": "stryker run",
		"test:mutation:incremental": "stryker run --incremental",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"docker:restart": "docker compose restart",
		"db:generate": "drizzle-kit generate && node scripts/make-idempotent.js",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"etl:an-actors": "node --import tsx scripts/etl/import-actors.ts",
		"etl:an-scrutins": "node --import tsx scripts/etl/import-scrutins.ts",
		"etl:an-laws": "node --import tsx scripts/etl/import-laws.ts",
		"etl:an-link-laws": "node --import tsx scripts/etl/link-scrutins-by-title.ts",
		"etl:an-dossiers": "node --import tsx scripts/etl/import-dossiers-an.ts",
		"etl:senat-laws": "node --import tsx scripts/etl/import-senat-laws.ts",
		"etl:senat-senators": "node --import tsx scripts/etl/import-senat-senators.ts",
		"etl:senat-mandates-history": "node --import tsx scripts/etl/import-senat-mandates-history.ts",
		"etl:europarl-meps": "node --import tsx scripts/etl/import-europarl-meps.ts",
		"etl:europarl-historical": "node --import tsx scripts/etl/import-europarl-historical.ts",
		"etl:europarl-votes": "node --import tsx scripts/etl/import-europarl-votes.ts",
		"etl:europarl-laws": "node --import tsx scripts/etl/import-europarl-laws.ts",
		"etl:europarl-activity-stats": "node --import tsx scripts/etl/import-europarl-activity-stats.ts",
		"etl:europarl-law-texts": "node --import tsx scripts/etl/enrich-europarl-law-texts.ts",
		"etl:europarl-enrich-groups": "node --import tsx scripts/etl/enrich-pe-group-names.ts",
		"etl:external-colors": "node --import tsx scripts/etl/import-external-colors.ts",
		"etl:an-all": "node --import tsx scripts/etl/import-all.ts",
		"etl:an-nosdeputes": "node --import tsx scripts/etl/import-nosdeputes.ts",
		"etl:an-nosdeputes-stats": "node --import tsx scripts/etl/import-nosdeputes-stats.ts",
		"etl:senat-nossenateurs-stats": "node --import tsx scripts/etl/import-nossenateurs-stats.ts",
		"etl:senat-activity-stats": "node --import tsx scripts/etl/import-senat-activity-stats.ts",
		"etl:classify-scrutins": "node --import tsx scripts/etl/classify-scrutins.ts",
		"etl:analyze-laws": "node --import tsx scripts/etl/analyze-laws.ts",
		"etl:an-law-texts": "node --import tsx scripts/etl/import-law-texts-piste.ts",
		"etl:an-download": "node --import tsx scripts/etl/download-data.ts",
		"etl:an-amendements": "node --import tsx scripts/etl/import-amendements.ts",
		"etl:colors": "node --import tsx scripts/etl/sync-group-colors.ts",
		"etl:political-positions": "node --import tsx scripts/etl/import-political-positions.ts",
		"etl:seed-pe-positions": "node --import tsx scripts/etl/seed-pe-positions.ts",
		"etl:simplify-scrutins": "node --import tsx scripts/etl/simplify-scrutins.ts",
		"etl:generate-similar": "node --max-old-space-size=4096 --import tsx scripts/etl/generate-similar-scrutins.ts",
		"lint": "npm run lint:format && npm run lint:types",
		"lint:format": "prettier --check \"src/**/*.{js,ts,svelte,css,md,json}\"",
		"lint:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint-staged": "lint-staged",
		"commitlint": "commitlint"
	},
	"lint-staged": {
		"*.{js,ts,svelte,css,md,json}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@huggingface/transformers": "^3.8.1",
		"@playwright/test": "^1.57.0",
		"@stryker-mutator/core": "^9.4.0",
		"@stryker-mutator/typescript-checker": "^9.4.0",
		"@stryker-mutator/vitest-runner": "^9.4.0",
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.9",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/leaflet": "^1.9.21",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.15",
		"drizzle-kit": "^0.31.8",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"jsdom": "^27.0.1",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.53.9",
		"svelte-check": "^4.0.5",
		"tsx": "^4.21.0",
		"typescript": "^5.6.3",
		"vite": "^5.4.11",
		"vitest": "^4.0.15"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": "^0.25.0"
	},
	"dependencies": {
		"@ethercorps/sveltekit-og": "^4.2.1",
		"@frederictriquet/femtologger": "^0.1.4",
		"@tricoteuses/assemblee": "^2.5.31",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dotenv": "^17.2.4",
		"drizzle-orm": "^0.45.2",
		"layercake": "^10.0.2",
		"leaflet": "^1.9.4",
		"postgres": "^3.4.8"
	}
}
